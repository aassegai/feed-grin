#!/bin/bash
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  printf '%s\n' 'Usage: bash create-xcode-project.command [both|macos|ios] [output-directory]'
  printf '%s\n' 'Requires macOS and full Xcode. Both platforms are generated by default.'
  exit 0
fi
if [[ "$(uname -s)" != "Darwin" ]]; then
  printf '%s\n' 'Run this script on a Mac with full Xcode installed.' >&2
  exit 1
fi
if ! command -v xcrun >/dev/null 2>&1; then
  printf '%s\n' 'Install and launch Xcode before running this script.' >&2
  exit 1
fi

FEED_GRIN_SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -f "$FEED_GRIN_SCRIPT_DIR/extension/manifest.json" ]]; then
  FEED_GRIN_SOURCE="$FEED_GRIN_SCRIPT_DIR/extension"
else
  FEED_GRIN_SOURCE="$FEED_GRIN_SCRIPT_DIR/../extension"
fi
if [[ ! -f "$FEED_GRIN_SOURCE/manifest.json" ]]; then
  printf '%s\n' 'The extension folder is missing. Extract the entire Safari kit first.' >&2
  exit 1
fi
FEED_GRIN_OUTPUT="${2:-$FEED_GRIN_SCRIPT_DIR/build}"
if [[ -e "$FEED_GRIN_OUTPUT" ]]; then
  printf 'Output already exists: %s\nChoose a new output directory.\n' "$FEED_GRIN_OUTPUT" >&2
  exit 1
fi
case "${1:-both}" in
  both) set -- ;;
  macos) set -- --macos-only ;;
  ios) set -- --ios-only ;;
  *) printf '%s\n' 'Platform must be both, macos, or ios.' >&2; exit 1 ;;
esac

if xcrun --find safari-web-extension-packager >/dev/null 2>&1; then
  FEED_GRIN_PACKAGER=safari-web-extension-packager
elif xcrun --find safari-web-extension-converter >/dev/null 2>&1; then
  FEED_GRIN_PACKAGER=safari-web-extension-converter
else
  printf '%s\n' 'Safari packaging tool not found. Select a full Xcode installation in Xcode > Settings > Locations.' >&2
  exit 1
fi

xcrun "$FEED_GRIN_PACKAGER" "$FEED_GRIN_SOURCE" \
  --project-location "$FEED_GRIN_OUTPUT" \
  --app-name 'Feed Grin' \
  --bundle-identifier "${FEED_GRIN_BUNDLE_ID:-com.aassegai.feedgrin}" \
  --swift --copy-resources --no-open --no-prompt \
  "$@"

printf '\nProject created under: %s\n' "$FEED_GRIN_OUTPUT"
printf '%s\n' 'Open the .xcodeproj in Xcode. Select a macOS or iOS app scheme.'
printf '%s\n' 'For an iPhone/iPad, choose your signing team and device, then Run.'
if [[ -z "${FEED_GRIN_NO_OPEN:-}" ]] && command -v open >/dev/null 2>&1; then
  open "$FEED_GRIN_OUTPUT"
fi
