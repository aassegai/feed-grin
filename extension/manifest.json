{
  "manifest_version": 3,
  "name": "Feed Grin",
  "version": "1.0.1",
  "description": "Скрывает обычные посты ленты LinkedIn, сохраняя рекламу. Троллфейс включается отдельно.",
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/replacement.jpg"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Feed Grin — настройки ленты",
    "default_popup": "popup.html"
  }
}
